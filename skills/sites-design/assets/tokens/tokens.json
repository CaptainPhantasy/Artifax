{
  "$description": "Sites design tokens. Source of truth. Edit here, then run scripts/compile-tokens.mjs to regenerate tokens.css. Group names double as CSS custom-property prefixes; the `semantic` group emits unprefixed role variables.",
  "$schema": "https://tr.designtokens.org/format/",

  "$contrast": {
    "$description": "Compile-time WCAG assertions. Each pair is checked against fully resolved colors in BOTH themes (alpha roles composite over the page background first). The compiler exits non-zero on any failure — fix the token source, never the rendered output.",
    "pairs": [
      { "fg": "ink",      "bg": "bg",        "min": 4.5 },
      { "fg": "ink",      "bg": "surface",   "min": 4.5 },
      { "fg": "ink-2",    "bg": "surface",   "min": 4.5 },
      { "fg": "ink-3",    "bg": "surface-2", "min": 4.5 },
      { "fg": "on-brand", "bg": "brand",     "min": 4.5 },
      { "fg": "brand",    "bg": "surface",   "min": 3.0 },
      { "fg": "success",  "bg": "success-bg", "min": 3.0 },
      { "fg": "warning",  "bg": "warning-bg", "min": 3.0 },
      { "fg": "danger",   "bg": "danger-bg",  "min": 3.0 },
      { "fg": "info",     "bg": "info-bg",    "min": 3.0 }
    ]
  },

  "n": {
    "$description": "Neutral ramp, derived: each step is tinted toward the brand at compile time (see $extensions.tint), so recoloring the brand re-tints every neutral. paper -> ink.",
    "$extensions": { "tint": { "source": "{b.500}", "$mix": 0.05, "$except": ["0", "1000"] } },
    "0":    { "$type": "color", "$value": "#ffffff" },
    "25":   { "$type": "color", "$value": "#fdfcfb" },
    "50":   { "$type": "color", "$value": "#faf9f7" },
    "100":  { "$type": "color", "$value": "#f4f2ef" },
    "150":  { "$type": "color", "$value": "#ebe8e4" },
    "200":  { "$type": "color", "$value": "#e2ded8" },
    "300":  { "$type": "color", "$value": "#cfc9c1" },
    "400":  { "$type": "color", "$value": "#a8a199" },
    "500":  { "$type": "color", "$value": "#6e6862" },
    "600":  { "$type": "color", "$value": "#5c5650" },
    "700":  { "$type": "color", "$value": "#423d38" },
    "800":  { "$type": "color", "$value": "#2b2723" },
    "900":  { "$type": "color", "$value": "#1a1715" },
    "950":  { "$type": "color", "$value": "#0f0d0c" },
    "1000": { "$type": "color", "$value": "#000000" }
  },

  "b": {
    "$description": "Brand ramp. Recolor the entire product by changing this ramp.",
    "50":  { "$type": "color", "$value": "#eef2ff" },
    "100": { "$type": "color", "$value": "#e0e7ff" },
    "200": { "$type": "color", "$value": "#c7d2fe" },
    "300": { "$type": "color", "$value": "#a5b4fc" },
    "400": { "$type": "color", "$value": "#818cf8" },
    "500": { "$type": "color", "$value": "#6366f1" },
    "600": { "$type": "color", "$value": "#4f46e5" },
    "700": { "$type": "color", "$value": "#4338ca" },
    "800": { "$type": "color", "$value": "#3730a3" },
    "900": { "$type": "color", "$value": "#312e81" },
    "950": { "$type": "color", "$value": "#1e1b4b" }
  },

  "success": { "$description": "Status fills. 500 steps are darkened to hold WCAG contrast on their tinted backgrounds.", "500": { "$type": "color", "$value": "#15803d" }, "sub": { "$type": "color", "$value": "#dcfce7" } },
  "warning": { "$description": "Status fills. 500 steps are darkened to hold WCAG contrast on their tinted backgrounds.", "500": { "$type": "color", "$value": "#b45309" }, "sub": { "$type": "color", "$value": "#fef3c7" } },
  "danger":  { "$description": "Status fills.", "500": { "$type": "color", "$value": "#dc2626" }, "sub": { "$type": "color", "$value": "#fee2e2" } },
  "info":    { "$description": "Status fills.", "500": { "$type": "color", "$value": "#0284c7" }, "sub": { "$type": "color", "$value": "#e0f2fe" } },

  "sp": {
    "$description": "Space scale, 4px base.",
    "1":  { "$type": "dimension", "$value": "0.25rem" },
    "2":  { "$type": "dimension", "$value": "0.5rem" },
    "3":  { "$type": "dimension", "$value": "0.75rem" },
    "4":  { "$type": "dimension", "$value": "1rem" },
    "5":  { "$type": "dimension", "$value": "1.25rem" },
    "6":  { "$type": "dimension", "$value": "1.5rem" },
    "8":  { "$type": "dimension", "$value": "2rem" },
    "10": { "$type": "dimension", "$value": "2.5rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" },
    "20": { "$type": "dimension", "$value": "5rem" },
    "24": { "$type": "dimension", "$value": "6rem" },
    "32": { "$type": "dimension", "$value": "8rem" }
  },

  "rd": {
    "$description": "Radius scale.",
    "xs":   { "$type": "dimension", "$value": "0.25rem" },
    "sm":   { "$type": "dimension", "$value": "0.375rem" },
    "md":   { "$type": "dimension", "$value": "0.5rem" },
    "lg":   { "$type": "dimension", "$value": "0.75rem" },
    "xl":   { "$type": "dimension", "$value": "1rem" },
    "2xl":  { "$type": "dimension", "$value": "1.5rem" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },

  "ff": {
    "$description": "Font families (font-family).",
    "sans":    { "$type": "fontFamily", "$value": "var(--font-geist-sans), ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" },
    "display": { "$type": "fontFamily", "$value": "var(--font-geist-sans), ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" },
    "mono":    { "$type": "fontFamily", "$value": "var(--font-geist-mono), ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace" }
  },

  "fs": {
    "$description": "Type scale.",
    "xs":   { "$type": "dimension", "$value": "0.75rem" },
    "sm":   { "$type": "dimension", "$value": "0.875rem" },
    "base": { "$type": "dimension", "$value": "1rem" },
    "lg":   { "$type": "dimension", "$value": "1.125rem" },
    "xl":   { "$type": "dimension", "$value": "1.25rem" },
    "2xl":  { "$type": "dimension", "$value": "1.5rem" },
    "3xl":  { "$type": "dimension", "$value": "1.875rem" },
    "4xl":  { "$type": "dimension", "$value": "2.25rem" },
    "5xl":  { "$type": "dimension", "$value": "3rem" },
    "6xl":  { "$type": "dimension", "$value": "3.75rem" },
    "7xl":  { "$type": "dimension", "$value": "4.5rem" }
  },

  "lh": {
    "$description": "Line heights.",
    "tight":   { "$type": "number", "$value": "1.1" },
    "snug":    { "$type": "number", "$value": "1.25" },
    "normal":  { "$type": "number", "$value": "1.5" },
    "relaxed": { "$type": "number", "$value": "1.7" }
  },

  "ls": {
    "$description": "Letter spacing.",
    "tight":  { "$type": "dimension", "$value": "-0.02em" },
    "normal": { "$type": "dimension", "$value": "0" },
    "wide":   { "$type": "dimension", "$value": "0.06em" },
    "wider":  { "$type": "dimension", "$value": "0.14em" }
  },

  "fw": {
    "$description": "Font weights.",
    "regular":  { "$type": "fontWeight", "$value": "400" },
    "medium":   { "$type": "fontWeight", "$value": "500" },
    "semibold": { "$type": "fontWeight", "$value": "600" },
    "bold":     { "$type": "fontWeight", "$value": "700" }
  },

  "sh": {
    "$description": "Elevation.",
    "xs":    { "$type": "shadow", "$value": "0 1px 2px 0 rgb(15 13 12 / 0.04)" },
    "sm":    { "$type": "shadow", "$value": "0 1px 3px 0 rgb(15 13 12 / 0.08), 0 1px 2px -1px rgb(15 13 12 / 0.06)" },
    "md":    { "$type": "shadow", "$value": "0 4px 12px -2px rgb(15 13 12 / 0.10), 0 2px 6px -2px rgb(15 13 12 / 0.06)" },
    "lg":    { "$type": "shadow", "$value": "0 12px 28px -6px rgb(15 13 12 / 0.14), 0 4px 10px -4px rgb(15 13 12 / 0.08)" },
    "xl":    { "$type": "shadow", "$value": "0 24px 48px -12px rgb(15 13 12 / 0.20)" },
    "inner": { "$type": "shadow", "$value": "inset 0 1px 2px 0 rgb(15 13 12 / 0.06)" }
  },

  "dur": {
    "$description": "Motion durations.",
    "instant": { "$type": "duration", "$value": "80ms" },
    "fast":    { "$type": "duration", "$value": "140ms" },
    "base":    { "$type": "duration", "$value": "220ms" },
    "slow":    { "$type": "duration", "$value": "340ms" },
    "slower":  { "$type": "duration", "$value": "520ms" }
  },

  "curve": {
    "$description": "Easing curves. Exposed to Tailwind as --ease-*.",
    "standard":   { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0, 0, 1)" },
    "decelerate": { "$type": "cubicBezier", "$value": "cubic-bezier(0, 0, 0.2, 1)" },
    "accelerate": { "$type": "cubicBezier", "$value": "cubic-bezier(0.4, 0, 1, 1)" },
    "emphasized": { "$type": "cubicBezier", "$value": "cubic-bezier(0.3, 1.4, 0.4, 1)" }
  },

  "z": {
    "$description": "Stacking order.",
    "base":     { "$type": "number", "$value": "0" },
    "dropdown": { "$type": "number", "$value": "1000" },
    "sticky":   { "$type": "number", "$value": "1100" },
    "overlay":  { "$type": "number", "$value": "1200" },
    "modal":    { "$type": "number", "$value": "1300" },
    "toast":    { "$type": "number", "$value": "1400" },
    "tooltip":  { "$type": "number", "$value": "1500" }
  },

  "semantic": {
    "$description": "Role tokens. Emitted WITHOUT the group prefix. $extensions.dark carries the dark-theme value.",
    "bg":           { "$type": "color", "$value": "{n.25}",  "$extensions": { "dark": { "$value": "{n.950}" } } },
    "surface":      { "$type": "color", "$value": "{n.0}",   "$extensions": { "dark": { "$value": "{n.900}" } } },
    "surface-2":    { "$type": "color", "$value": "{n.50}",  "$extensions": { "dark": { "$value": "{n.800}" } } },
    "surface-3":    { "$type": "color", "$value": "{n.100}", "$extensions": { "dark": { "$value": "{n.700}" } } },
    "ink":          { "$type": "color", "$value": "{n.900}", "$extensions": { "dark": { "$value": "{n.50}" } } },
    "ink-2":        { "$type": "color", "$value": "{n.600}", "$extensions": { "dark": { "$value": "{n.300}" } } },
    "ink-3":        { "$type": "color", "$value": "{n.500}", "$extensions": { "dark": { "$value": "{n.400}" } } },
    "line":         { "$type": "color", "$value": "{n.150}", "$extensions": { "dark": { "$value": "rgb(255 255 255 / 0.10)" } } },
    "line-2":       { "$type": "color", "$value": "{n.300}", "$extensions": { "dark": { "$value": "rgb(255 255 255 / 0.20)" } } },
    "brand":        { "$type": "color", "$value": "{b.600}", "$extensions": { "dark": { "$value": "{b.400}" } } },
    "brand-hover":  { "$type": "color", "$value": "{b.700}", "$extensions": { "dark": { "$value": "{b.300}" } } },
    "brand-subtle": { "$type": "color", "$value": "{b.50}",  "$extensions": { "dark": { "$value": "rgb(129 140 248 / 0.16)" } } },
    "on-brand":     { "$type": "color", "$value": "{n.0}",   "$extensions": { "dark": { "$value": "{n.1000}" } } },
    "success":      { "$type": "color", "$value": "{success.500}", "$extensions": { "dark": { "$value": "#34d399" } } },
    "warning":      { "$type": "color", "$value": "{warning.500}", "$extensions": { "dark": { "$value": "#fbbf24" } } },
    "danger":       { "$type": "color", "$value": "{danger.500}",  "$extensions": { "dark": { "$value": "#f87171" } } },
    "info":         { "$type": "color", "$value": "{info.500}",    "$extensions": { "dark": { "$value": "#38bdf8" } } },
    "success-bg":   { "$type": "color", "$value": "{success.sub}", "$extensions": { "dark": { "$value": "rgb(52 211 153 / 0.14)" } } },
    "warning-bg":   { "$type": "color", "$value": "{warning.sub}", "$extensions": { "dark": { "$value": "rgb(251 191 36 / 0.14)" } } },
    "danger-bg":    { "$type": "color", "$value": "{danger.sub}",  "$extensions": { "dark": { "$value": "rgb(248 113 113 / 0.14)" } } },
    "info-bg":      { "$type": "color", "$value": "{info.sub}",    "$extensions": { "dark": { "$value": "rgb(56 189 248 / 0.14)" } } },
    "ring":         { "$type": "color", "$value": "{b.500}", "$extensions": { "dark": { "$value": "{b.400}" } } },
    "scrim":        { "$type": "color", "$value": "rgb(15 13 12 / 0.5)", "$extensions": { "dark": { "$value": "rgb(0 0 0 / 0.6)" } } }
  }
}
